# MYML Canvas environment template
# Copy this file to .env and fill values locally. Do not commit real secrets.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Optional persistent data directory. Leave empty to use ./library.
# In deployment, prefer a stable mounted path such as /data/myml/library.
LIBRARY_DIR=

# -----------------------------------------------------------------------------
# Auth / DB
# -----------------------------------------------------------------------------
MYML_AUTH_SECRET=please_change_this
MYML_COOKIE_SECURE=false

# PostgreSQL is the primary database for users/auth and generation tasks.
# Use either DATABASE_URL or the PG* variables below. Do not commit real passwords.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=myml_user
PGPASSWORD=change_this_outside_git
PGDATABASE=myml_canvas
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
# Keep certificate verification enabled in production. Set PGSSL_REJECT_UNAUTHORIZED=false only for self-signed certificates or local testing.

# Docker-style PostgreSQL aliases are also accepted by the app.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=myml_user
POSTGRES_PASSWORD=change_this_outside_git
POSTGRES_DB=myml_canvas

# Deprecated local-only SQLite fallback from earlier builds. Do not use for cloud deployments.
# MYML_DB_PATH=library/database/myml.db

MYML_SEED_ADMIN_USERNAME=myml
MYML_SEED_ADMIN_PASSWORD=change_this_before_first_start
MYML_SEED_INTERNAL_USERS=false
# Required only when MYML_SEED_INTERNAL_USERS=true. Do not commit real passwords.
MYML_GROUP1_USERNAME=
MYML_GROUP1_PASSWORD=
MYML_GROUP2_USERNAME=
MYML_GROUP2_PASSWORD=

# Deprecated first-phase single-account auth. Do not use for current login.
# MYML_ADMIN_USERNAME=
# MYML_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Task worker
# -----------------------------------------------------------------------------
# Development default: keep disabled so created tasks stay queued and do not submit paid jobs.
# Staging default: set TASK_WORKER_ENABLED=true with low concurrency.
# Production default: set TASK_WORKER_ENABLED=true and tune limits to provider quotas.
TASK_WORKER_ENABLED=false
TASK_WORKER_ID=
TASK_WORKER_CONCURRENCY=2
TASK_LEASE_MS=120000
TASK_HEARTBEAT_MS=30000
SYSTEM_MAX_RUNNING_IMAGE_TASKS=4
USER_MAX_RUNNING_IMAGE_TASKS=2
PROVIDER_MAX_RUNNING_APIMART=2
PROVIDER_MAX_RUNNING_DATALER=1
PROVIDER_MAX_RUNNING_PIKACHU=1
PROVIDER_MAX_RUNNING_ATLAS=1
IMAGE_TASK_POLL_INTERVAL_MS=5000
IMAGE_TASK_TIMEOUT_MS=600000
IMAGE_TASK_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# Provider: APIMart
# -----------------------------------------------------------------------------
# Team provider credentials in PostgreSQL take priority over these values.
# Keep .env provider keys as fallback only. Never commit real provider API keys.
# Require each team/user/global scope to have an active provider credential.
# When true, .env provider keys are not used as fallback for user tasks.
REQUIRE_TEAM_PROVIDER_CREDENTIALS=false
# Strong secret used to encrypt provider_credentials.api_key_encrypted.
# Use a long random value or a base64-encoded 32-byte key.
# Required when writing encrypted provider credentials or decrypting v1: values.
# Production deployments must configure and back up this value securely.
# Never commit this key to git.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
# APIMart API base URL, for example https://api.apimart.ai/v1.
APIMART_BASE_URL=
APIMART_API_KEY=
APIMART_TEXT_MODEL=
APIMART_IMAGE_MODEL=
APIMART_IMAGE_FALLBACK_MODEL=
APIMART_IMAGE_RESOLUTION=
APIMART_IMAGE_SIZE=
# APIMart submit/poll single-request hard timeout; prevents worker fetch calls from hanging too long.
APIMART_REQUEST_TIMEOUT_MS=30000
APIMART_IMAGE_POLL_INTERVAL_MS=
APIMART_IMAGE_POLL_TIMEOUT_MS=

# Legacy provider keys still used by older routes or optional integrations.
GEMINI_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
HAILUO_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=

# -----------------------------------------------------------------------------
# Experimental providers
# -----------------------------------------------------------------------------
# Disabled by default. Enable only for controlled testing.
ENABLE_DATALER_PROVIDER=false
ENABLE_PIKACHU_PROVIDER=false
ENABLE_ATLAS_PROVIDER=false
# Atlas Nano Banana 2 is separately gated because some accounts/routes return 404.
ENABLE_ATLAS_NANO_BANANA_2=false

# Dataler / Chaowen API image provider for Nano Banana experiments.
DATALER_API_BASE_URL=
DATALER_API_KEY=
DATALER_REQUEST_TIMEOUT_MS=300000
DATALER_IMAGE_MODEL=gemini-3.1-flash-image-preview
DATALER_IMAGE_SIZE=auto
DATALER_IMAGE_RESOLUTION=2K

# Pikachu GPT-Image-2 provider.
PIKACHU_BASE_URL=https://pikachu.claudecode.love/v1
PIKACHU_API_KEY=
PIKACHU_REQUEST_TIMEOUT_MS=300000
PIKACHU_IMAGE_MODEL=gpt-image-2
PIKACHU_IMAGE_QUALITY=medium

# Atlas Cloud GPT Image provider. Experimental and disabled by default.
# Team provider credentials in PostgreSQL can override ATLAS_API_KEY per team.
# Docker deployments pass these Atlas values through from the host environment.
ATLAS_BASE_URL=https://api.atlascloud.ai
# Optional alias for deployments that prefer *_API_BASE_URL naming.
ATLAS_API_BASE_URL=
ATLAS_API_KEY=
ATLAS_TEXT_TO_IMAGE_MODEL=openai/gpt-image-2/text-to-image
ATLAS_EDIT_MODEL=openai/gpt-image-2/edit
ATLAS_NANO_BANANA_2_TEXT_MODEL=google/nano-banana-2/text-to-image
ATLAS_NANO_BANANA_2_EDIT_MODEL=google/nano-banana-2/edit
ATLAS_NANO_BANANA_2_OUTPUT_FORMAT=default
ATLAS_NANO_BANANA_2_MEDIA_RESOLUTION=default
ATLAS_NANO_BANANA_2_THINKING_LEVEL=default
ATLAS_REQUEST_TIMEOUT_MS=300000

# Company intranet NewAPI / OpenAI-compatible image provider.
# Final image request URL is NEWAPI_BASE_URL + /chat/completions when NEWAPI_BASE_URL ends with /v1.
NEWAPI_BASE_URL=http://10.0.0.30:13000/v1
NEWAPI_API_KEY=
NEWAPI_REQUEST_TIMEOUT_MS=300000
NEWAPI_IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# T8 image provider. Text-to-image only in the current integration.
T8_BASE_URL=
T8_API_KEY=
T8_REQUEST_TIMEOUT_MS=300000
T8_GPT_IMAGE_MODEL=gpt-image-2
T8_NANO_BANANA_MODEL=gemini-3.1-flash-image-preview

# -----------------------------------------------------------------------------
# Legacy fallback
# -----------------------------------------------------------------------------
# Keep false so task creation failures do not bypass the queue via /api/generate-image.
# The legacy endpoint also requires legacySource=camera-angle or legacySource=explicit-fallback.
VITE_ENABLE_LEGACY_GENERATION_FALLBACK=false

CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_NANO_BANANA_BASE_URL=
CUSTOM_NANO_BANANA_API_KEY=
CUSTOM_NANO_BANANA_MODEL=
CUSTOM_SEEDANCE_BASE_URL=
CUSTOM_SEEDANCE_API_KEY=
CUSTOM_SEEDANCE_MODEL=
CUSTOM_SEEDANCE_PUBLIC_BASE_URL=
PUBLIC_BASE_URL=
SERVER_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Matting
# -----------------------------------------------------------------------------
MYML_MATTING_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Agent / Chat
# -----------------------------------------------------------------------------
CHAT_API_KEY=
CHAT_API_BASE_URL=
CHAT_MODEL=
CHAT_REASONING_EFFORT=
CHAT_TOPIC_MODEL=

# -----------------------------------------------------------------------------
# Social integrations
# -----------------------------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Local model discovery
# -----------------------------------------------------------------------------
LOCAL_MODELS_DIR=

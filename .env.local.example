# MYML Canvas local-only development template.
# Copy to .env for local Atlas/provider debugging.
# Do not point local development at the shared 10.0.0.30 test database.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LIBRARY_DIR=./library

# Local PostgreSQL. Create this database on your own machine first.
DATABASE_URL=postgres://postgres:<LOCAL_POSTGRES_PASSWORD>@127.0.0.1:5432/myml_canvas_local
PGSSL=false

# Local auth seed. The seed password is used when the user is first created.
MYML_AUTH_SECRET=MYML_LOCAL_DEV_SECRET_CHANGE_ME
MYML_COOKIE_SECURE=false
MYML_SEED_ADMIN_USERNAME=myml
MYML_SEED_ADMIN_PASSWORD=<LOCAL_DEV_ADMIN_PASSWORD>
MYML_SEED_INTERNAL_USERS=false

# Local provider debugging.
# Keep strict team credentials disabled until the model/provider/save path is stable.
REQUIRE_TEAM_PROVIDER_CREDENTIALS=false
ENABLE_ATLAS_PROVIDER=true
ENABLE_ATLAS_NANO_BANANA_2=true
ATLAS_BASE_URL=https://api.atlascloud.ai
ATLAS_API_KEY=<YOUR_MYML_LOCAL_DEV_ATLAS_KEY>
ATLAS_TEXT_TO_IMAGE_MODEL=openai/gpt-image-2/text-to-image
ATLAS_EDIT_MODEL=openai/gpt-image-2/edit
ATLAS_NANO_BANANA_2_TEXT_MODEL=google/nano-banana-2/text-to-image
ATLAS_NANO_BANANA_2_EDIT_MODEL=google/nano-banana-2/edit
ATLAS_NANO_BANANA_2_OUTPUT_FORMAT=default
ATLAS_NANO_BANANA_2_MEDIA_RESOLUTION=default
ATLAS_NANO_BANANA_2_THINKING_LEVEL=default
ATLAS_REQUEST_TIMEOUT_MS=300000
ATLAS_DEBUG_REQUESTS=false

# Company intranet NewAPI / OpenAI-compatible image provider.
NEWAPI_BASE_URL=http://10.0.0.30:13000/v1
NEWAPI_API_KEY=<YOUR_MYML_LOCAL_DEV_NEWAPI_KEY>
NEWAPI_REQUEST_TIMEOUT_MS=300000
NEWAPI_IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# T8 image provider. Text-to-image generations only.
T8_BASE_URL=
T8_API_KEY=<YOUR_MYML_LOCAL_DEV_T8_KEY>
T8_REQUEST_TIMEOUT_MS=300000
T8_GPT_IMAGE_MODEL=gpt-image-2
T8_NANO_BANANA_MODEL=gemini-3.1-flash-image-preview

# Worker controls for local tests. Use low concurrency first.
TASK_WORKER_ENABLED=true
TASK_WORKER_CONCURRENCY=1
SYSTEM_MAX_RUNNING_IMAGE_TASKS=1
USER_MAX_RUNNING_IMAGE_TASKS=1
PROVIDER_MAX_RUNNING_ATLAS=1
TASK_LEASE_MS=120000
TASK_HEARTBEAT_MS=30000
IMAGE_TASK_TIMEOUT_MS=600000

# Other providers stay disabled for local Atlas debugging.
ENABLE_DATALER_PROVIDER=false
ENABLE_PIKACHU_PROVIDER=false

# Keep false so normal canvas generation cannot silently bypass /api/tasks/image.
# Camera Angle still calls /api/generate-image with legacySource=camera-angle.
VITE_ENABLE_LEGACY_GENERATION_FALLBACK=false

# Required only when using encrypted DB provider_credentials locally.
# Not needed for simple REQUIRE_TEAM_PROVIDER_CREDENTIALS=false + ATLAS_API_KEY tests.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
